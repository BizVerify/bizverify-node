{
  "name": "@bizverify/sdk",
  "version": "0.2.1",
  "description": "Official Node.js/TypeScript SDK for the BizVerify API — verify business entities against official government registries (Secretary of State, Companies House) across the US and Europe.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bizverify",
    "business-verification",
    "entity-verification",
    "kyb",
    "know-your-business",
    "secretary-of-state",
    "companies-house",
    "api-client",
    "due-diligence",
    "compliance",
    "sdk"
  ],
  "homepage": "https://bizverify.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/BizVerify/bizverify-node.git"
  },
  "bugs": {
    "url": "https://github.com/BizVerify/bizverify-node/issues"
  },
  "author": "BizVerify <hello@bizverify.co> (https://bizverify.co)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
